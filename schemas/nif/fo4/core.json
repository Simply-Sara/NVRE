    },
    {
     "name": "hair_tint_color",
     "type": "color3",
     "cond": "(shader_flags_1 & 262144) != 0"
    }
   ],
   "note": "Fallout 4 BSLightingShaderProperty layout (140 bytes base, 146 bytes with environment mapping)."
  },
