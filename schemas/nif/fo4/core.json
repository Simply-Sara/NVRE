     "type": "BSSPWetnessParams"
    },
    {
     "name": "environment_map_scale",
     "type": "f32",
     "cond": "(shader_flags_1 & 128) != 0"
    },
    {
     "name": "use_screen_space_reflections",
     "type": "bool",
     "cond": "(shader_flags_1 & 128) != 0"
    },
    {
     "name": "wetness_control_use_ssr",
     "type": "bool",
     "cond": "(shader_flags_1 & 128) != 0"
    },
    {
