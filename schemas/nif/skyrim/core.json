  "NiGeometryData": {
   "inherit": "NiObject",
   "abstract": true,
   "fields": [
    {
     "name": "group_id",
     "type": "i32"
    },
    {
     "name": "num_vertices",
     "type": "u16",
     "exclude": [
      "NiPSysData"
     ]
    },
    {
     "name": "num_vertices",
     "type": "u16",
     "only": [
      "NiPSysData"
     ],
     "cond": "bs_version < 34"
    },
    {
     "name": "bs_max_vertices",
     "type": "u16",
     "only": [
      "NiPSysData"
     ],
     "cond": "version == 0x14020007 && bs_version >= 34",
     "note": "nif.xml: Bethesda 20.2 particle data stores a maximum count here and no per-vertex arrays."
    },
    {
     "name": "keep_flags",
     "type": "u8"
    },
    {
     "name": "compress_flags",
     "type": "u8"
    },
    {
     "name": "has_vertices",
     "type": "bool"
    },
    {
     "name": "vertices",
     "type": "vec3",
     "length": "num_vertices",
     "cond": "has_vertices"
    },
    {
     "name": "data_flags",
     "type": "u16",
     "note": "nif.xml NiGeometryDataFlags: bits 0-5 UV set count, 12-15 tangent method.",
     "cond": "!(version == 0x14020007 && bs_version > 0)"
    },
    {
     "name": "bs_data_flags",
     "type": "u16",
     "note": "nif.xml BSGeometryDataFlags: bit 0 has UV, bits 6-11 Havok material, bit 12 has tangents.",
     "cond": "version == 0x14020007 && bs_version > 0"
    },
    {
     "name": "geometry_flags",
     "type": "u8",
     "length": "4",
     "note": "Skyrim's four flag bytes after the data flags, where Fallout has none."
    },
    {
     "name": "has_normals",
     "type": "bool"
    },
    {
     "name": "normals",
     "type": "vec3",
     "length": "num_vertices",
     "cond": "has_normals"
    },
    {
     "name": "tangents",
     "type": "vec3",
     "length": "num_vertices",
     "cond": "has_normals && ((data_flags | bs_data_flags) & 4096) != 0"
    },
    {
     "name": "bitangents",
     "type": "vec3",
     "length": "num_vertices",
     "cond": "has_normals && ((data_flags | bs_data_flags) & 4096) != 0"
    },
    {
     "name": "bounding_sphere",
     "type": "NiBound"
    },
    {
     "name": "has_vertex_colors",
     "type": "bool"
    },
    {
     "name": "vertex_colors",
     "type": "color4",
     "length": "num_vertices",
     "cond": "has_vertex_colors"
    },
    {
     "name": "uv_sets",
     "type": "vec2",
     "length": "(data_flags & 63) | (bs_data_flags & 1)",
     "width": "num_vertices"
    },
    {
     "name": "consistency_flags",
     "type": "ConsistencyType"
    },
    {
     "name": "additional_data",
     "type": "ref"
    }
   ]
  },
