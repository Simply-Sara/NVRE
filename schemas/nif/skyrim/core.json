     "type": "bool"
    },
    {
     "name": "triangles",
     "type": "triangle",
     "length": "num_triangles",
     "cond": "has_triangles"
    },
    {
     "name": "num_match_groups",
     "type": "u16"
    },
    {
     "name": "match_groups",
     "type": "MatchGroup",
     "length": "num_match_groups"
    }
   ]
  },
