     "cond": "shader_type == 16"
    },
    {
     "name": "left_eye_reflection_center",
     "type": "vec3",
     "cond": "shader_type == 16"
    },
    {
     "name": "right_eye_reflection_center",
     "type": "vec3",
     "cond": "shader_type == 16"
    },
    {
