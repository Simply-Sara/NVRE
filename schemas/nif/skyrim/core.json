     "type": "color3"
    },
    {
     "name": "skin_tint_color_2",
     "type": "color3",
     "cond": "shader_type == 5",
     "note": "nif.xml: the skin-tint shader's own colour."
    },
    {
     "name": "hair_tint_color",
     "type": "color3",
     "cond": "shader_type == 6",
     "note": "nif.xml: the hair-tint shader's own colour."
    },
    {
     "name": "max_passes",
     "type": "f32",
     "cond": "shader_type == 7",
     "note": "nif.xml: the parallax-occlusion shader's own maximum passes."
    },
    {
     "name": "scale",
     "type": "f32",
     "cond": "shader_type == 7",
     "note": "nif.xml: the parallax-occlusion shader's own scale."
    }
   ]
  },
  "BSShaderProperty": {
   "inherit": "NiShadeProperty",
   "fields": [],
   "note": "nif.xml marks BSShaderProperty's four fields NI_BS_LTE_FO3, so a Skyrim shader property has none of them and carries its own flags. This is the block `is_a` walks through to reach every Bethesda shader property: inheriting it is what makes `shape_props` read a Skyrim shape's `shader_flags`."
  },
  "NiShadeProperty": {
   "inherit": "NiObject",
   "fields": [
    {
     "name": "name",
     "type": "string"
    },
    {
     "name": "extra_data",
     "type": "ref"
    },
    {
     "name": "controller",
     "type": "ref"
    }
   ],
   "note": "A Skyrim shader property carries a plain extra-data pointer where the rest of the game carries a count and a list, so it has no extra-data array of its own. Measured: the pointer reads 0xFFFFFFFF. It inherits NiObject rather than NiProperty because NiProperty would add the extra-data array back."
  },
